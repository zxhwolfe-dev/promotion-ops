# Copy to .env outside shared folders; fill only the platforms you use.
PROMO_CDP=http://127.0.0.1:9234
# Default: ~/.promotion-ops. All processes using the same Chrome MUST share it.
# PROMO_STATE_DIR=/absolute/private/path/promotion-state
# PROMO_FOREGROUND=1
GMAIL_ACCOUNT_INDEX=0
GMAIL_EXPECTED_EMAIL=
REDDIT_USERNAME=
TENCENT_UID=
OSCHINA_UID=
CSDN_USERNAME=
# Required only for mutable profile changes: stable for retries, new for a new change.
PROFILE_CHANGE_ID=
PROMO_ARTICLE_TAG=人工智能
BAIDU_SITE=https://aiworkstation.cn
BAIDU_PUSH_TOKEN=
GSC_PROPERTY=sc-domain:aiworkstation.cn
# Copy config/targets.example.json and configure verified per-metric selectors.
# PROMO_TARGETS_FILE=config/targets.local.json
# PROMO_OUTPUT_DIR=/absolute/private/path/snapshots
# OSCHINA_COMMENT_SELECTOR=[data-comment-id]

# Optional platform -> array of body-only CSS selectors, verified on REAL readback pages.
# Defaults: unique visible article / [role="article"]. Never configure whole-page body.
# PROMO_ARTICLE_BODY_SELECTORS={"tencent":["#YOUR_VERIFIED_BODY_SELECTOR"]}
